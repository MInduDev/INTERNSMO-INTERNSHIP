PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/watchspace_db

# Generate two different random values before running outside a local demo.
JWT_SECRET=replace-with-a-random-access-token-secret
REFRESH_SECRET=replace-with-a-different-random-refresh-token-secret

# Required only when running the destructive seed script. Use different,
# private values of at least 12 characters; do not commit server/.env.
DEMO_HOST_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Optional. Leave blank to use timeline-only answers.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
