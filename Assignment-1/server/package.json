{
  "name": "watchspace-backend",
  "version": "1.0.0",
  "description": "Node.js and Express backend for WatchSpace AI with MongoDB, Socket.IO, and a timeline-based AI Co-Pilot",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "nodemon server.js",
    "dev": "nodemon server.js",
    "watch": "node --watch server.js",
    "seed": "node seed/seedData.js",
    "test:auth": "node test-auth-security.js",
    "test:analytics": "node test-session-analytics.js",
    "test:socket": "node test-socket-moderation.js",
    "test:playback": "node test-playback-state-machine.js",
    "test:ai": "node test-ai-grounding.js",
    "test:ai-provider": "node test-ai-provider.js",
    "test:recommendation": "node test-recommendation-scoring.js",
    "evaluate:recommendations": "node evaluate-recommendations.js",
